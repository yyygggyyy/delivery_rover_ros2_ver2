<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="empty">
    <!-- OPTIMIZED PHYSICS FOR INTEGRATED GPU -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- WORKING PLUGINS (CRASH-FREE) -->
    <plugin name="gz::sim::systems::Physics" filename="ignition-gazebo-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="ignition-gazebo-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="ignition-gazebo-contact-system"/>
    
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- GROUND PLANE -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- SUN LIGHT -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- UNIVERSITY CORRIDOR LAYOUT (3m WIDE HALLWAY) -->

    <!-- Main Left Wall Segment 1 -->
    <model name="wall_left_1">
      <static>true</static>
      <pose>-3.0 1.5 1.0 0 0 0</pose> <!-- x, y, z -->
      <link name="link">
        <collision name="col"><geometry><box><size>6.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Main Left Wall Segment 2 (Creates a Doorway Gap at x=1.0) -->
    <model name="wall_left_2">
      <static>true</static>
      <pose>5.0 1.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Main Right Wall (Continuous 14m Wall) -->
    <model name="wall_right">
      <static>true</static>
      <pose>1.0 -1.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>14.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>14.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Corridor Back Wall -->
    <model name="wall_back">
      <static>true</static>
      <pose>-6.0 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 3.2 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 3.2 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Corridor Front Wall (Dead End) -->
    <model name="wall_front">
      <static>true</static>
      <pose>8.0 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 3.2 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 3.2 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Classroom Room Divider (Inside the doorway at x=1.0) -->
    <model name="classroom_wall">
      <static>true</static>
      <pose>1.0 3.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>